<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vboxPoderes" alignment="TOP_CENTER" prefHeight="50" prefWidth="250.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.fiuba.algoritmos3.tp1powechess.Controlador.ControladorSecundario">
    <children>
        <VBox alignment="CENTER_LEFT">
            <children>
                <Label prefHeight="50" prefWidth="150.0" text="Jugador Negras">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin></Label>
                <ButtonBar buttonMinWidth="95.0" maxHeight="-Infinity" maxWidth="-Infinity" minWidth="-Infinity">
                    <buttons>
                        <Button fx:id="botonOfrecerTablasNegras" alignment="TOP_LEFT" mnemonicParsing="false" onAction="#gestionarTablas" text="Ofrecer Tablas" />
                        <Button fx:id="botonRendirseNegras" alignment="TOP_CENTER" mnemonicParsing="false" onAction="#gestionarAbandono" text="Rendirse" />
                    </buttons>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <padding>
                  <Insets right="45.0" />
               </padding>
                </ButtonBar>
                <Label prefHeight="50" prefWidth="150.0" text="Poderes disponibles">
               <VBox.margin>
                  <Insets bottom="10.0" top="5.0" />
               </VBox.margin></Label>
                <FlowPane fx:id="poderesNegras" prefHeight="200.0" prefWidth="200.0" />
            </children>
            <VBox.margin>
                <Insets bottom="50.0" top="50.0" />
            </VBox.margin>
            <padding>
                <Insets left="5.0" />
            </padding>
        </VBox>
        <VBox alignment="CENTER_LEFT">
            <children>
                <Label prefHeight="50" prefWidth="150" text="Jugador Blancas">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin></Label>
                <ButtonBar buttonMinWidth="95.0" maxHeight="-Infinity" maxWidth="-Infinity" minWidth="-Infinity">
                    <buttons>
                        <Button fx:id="botonOfrecerTablasBlancas" alignment="TOP_CENTER" mnemonicParsing="false" onAction="#gestionarTablas" text="Ofrecer Tablas" />
                        <Button fx:id="botonRendirseBlancas" alignment="TOP_CENTER" mnemonicParsing="false" onAction="#gestionarAbandono" text="Rendirse" />
                    </buttons>
               <padding>
                  <Insets right="45.0" />
               </padding>
                </ButtonBar>
                <Label prefHeight="50" prefWidth="150.0" text="Poderes disponibles">
               <VBox.margin>
                  <Insets bottom="10.0" top="5.0" />
               </VBox.margin></Label>
                <FlowPane fx:id="poderesBlancas" prefHeight="200.0" prefWidth="200.0" />
            </children>
            <VBox.margin>
                <Insets bottom="50.0" top="50.0" />
            </VBox.margin>
            <padding>
                <Insets left="5.0" />
            </padding>
        </VBox>
    </children>
</VBox>
