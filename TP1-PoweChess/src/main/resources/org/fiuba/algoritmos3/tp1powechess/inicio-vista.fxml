<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane prefHeight="700.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:id="panePrincipal" fx:controller="org.fiuba.algoritmos3.tp1powechess.Controlador.ControladorPrimario">
   <children>
      <ImageView fitHeight="711.0" fitWidth="706.0" layoutX="-6.0" layoutY="-3.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@imagenes/fondo_inicio.jpg" />
         </image>
      </ImageView>
      <Button layoutX="222.0" layoutY="271.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="254.0" text="Iniciar Partida" textAlignment="JUSTIFY" onAction="#entrarAlJuego">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button layoutX="223.0" layoutY="330.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="254.0" text="Cargar Partida" textAlignment="JUSTIFY" onAction="#cargarPartida">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button layoutX="223.0" layoutY="389.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="254.0" text="Opciones" textAlignment="JUSTIFY" onAction="#opciones">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button layoutX="223.0" layoutY="453.0" mnemonicParsing="false" prefHeight="46.0" prefWidth="254.0" text="Salir" textAlignment="JUSTIFY" onAction="#salirDelJuego">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
   </children>
</Pane>
