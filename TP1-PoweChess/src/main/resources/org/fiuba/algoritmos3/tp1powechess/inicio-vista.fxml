<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane fx:id="panePrincipal" prefHeight="750.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.fiuba.algoritmos3.tp1powechess.Controlador.ControladorPrimario">
   <children>
      <ImageView fitHeight="765.0" fitWidth="900.0" layoutY="-6.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@imagenes/fondo_inicio.jpg" />
         </image>
      </ImageView>
      <Button layoutX="305.0" layoutY="288.0" mnemonicParsing="false" onAction="#entrarAlJuego" prefHeight="43.0" prefWidth="273.0" text="Iniciar Partida" textAlignment="JUSTIFY">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button layoutX="306.0" layoutY="352.0" mnemonicParsing="false" onAction="#cargarPartida" prefHeight="35.0" prefWidth="273.0" text="Cargar Partida" textAlignment="JUSTIFY">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button layoutX="305.0" layoutY="415.0" mnemonicParsing="false" onAction="#opciones" prefHeight="42.0" prefWidth="273.0" text="Opciones" textAlignment="JUSTIFY">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button layoutX="305.0" layoutY="484.0" mnemonicParsing="false" onAction="#salirDelJuego" prefHeight="48.0" prefWidth="273.0" text="Salir" textAlignment="JUSTIFY">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
   </children>
</Pane>
