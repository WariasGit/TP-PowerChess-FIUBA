<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<Pane fx:id="panePrincipal" prefHeight="750.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" stylesheets="@css/styles.css" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.fiuba.algoritmos3.tp1powechess.Controlador.ControladorPrimario">
   <children>
      <ImageView fitHeight="765.0" fitWidth="900.0" layoutY="-6.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@imagenes/fondo.jpg" />
         </image>
      </ImageView>
      <Button layoutX="319.0" layoutY="285.0" mnemonicParsing="false" onAction="#entrarAlJuego" prefHeight="50.0" prefWidth="250.0" text="Iniciar Partida" textAlignment="JUSTIFY">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button layoutX="319.0" layoutY="350.0" mnemonicParsing="false" onAction="#cargarPartida" prefHeight="50.0" prefWidth="250.0" text="Cargar Partida" textAlignment="JUSTIFY">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button layoutX="319.0" layoutY="415.0" mnemonicParsing="false" onAction="#salirDelJuego" prefHeight="50.0" prefWidth="250.0" text="Salir" textAlignment="JUSTIFY">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
   </children>
</Pane>
